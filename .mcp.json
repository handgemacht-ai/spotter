{
  "mcpServers": {
    "tidewave": {
      "type": "http",
      "url": "http://localhost:1100/tidewave/mcp"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--chromeArg=--no-sandbox",
        "--chromeArg=--disable-setuid-sandbox",
        "--chromeArg=--ignore-certificate-errors"
      ]
    }
  }
}
